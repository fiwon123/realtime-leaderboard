# Generated by engineering-workflow template. Adapt to your project topology.

COMPONENTS := backend frontend

.PHONY: help check clean dev-up dev-down dev-frontend dev-frontend-log dev-shell dev-opencode dev-opencode-auto dev-log dev-build reset preflight

# Extra flags for the opencode invocation. `make opencode-auto` /
# `make dev-opencode-auto` set this to --auto, which auto-approves permissions
# that are not explicitly denied; the secret-file deny rules still apply.
OPENCODE_ARGS ?=

help:
	@grep -E '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

check: ## Run checks for all components
	@status=0; \
	for d in $(COMPONENTS); do \
	  echo "=== $$d ==="; \
	  if [ -f $$d/Makefile ]; then \
	    $(MAKE) -C $$d check || status=1; \
	  else \
	    echo "ERROR: No Makefile in $$d. Create one or remove it from COMPONENTS."; \
	    status=1; \
	  fi; \
	done; \
	exit $$status

clean: ## Remove build and cache artifacts
	@echo "cleaning"
	@if [ -f backend/Cargo.toml ]; then cargo clean --manifest-path backend/Cargo.toml; fi
	@if [ -d frontend ]; then rm -rf frontend/dist frontend/node_modules; fi

preflight:
	@test -x "$(HOME)/.opencode/bin/opencode" || { echo "ERROR: opencode not found at ~/.opencode/bin/opencode" >&2; exit 1; }
	@mkdir -p "$(HOME)/.config/opencode" "$(HOME)/.config/gh" && touch "$(HOME)/.gitconfig"
	@scripts/resolve-gh-token.sh --check >/dev/null 2>&1 || true

dev-up: preflight
	@HOST_UID=$$(id -u) HOST_GID=$$(id -g) GH_TOKEN=$$(scripts/resolve-gh-token.sh 2>/dev/null) GITHUB_TOKEN=$$(scripts/resolve-gh-token.sh 2>/dev/null) docker compose up -d --build
	@$(MAKE) dev-frontend

# Start the frontend dev server inside the running `dev` container. Vite binds
# 0.0.0.0:5173 (host:true) and the compose file publishes that port, so it is
# reachable at http://localhost:5173 (Vite falls back to the next free port if
# 5173 is held by something else). The API is in the same container on :8080,
# Vite's default proxy target. Waits for the container, refreshes dependencies
# when the lockfile is newer than the installed snapshot (or when the vite
# binary is missing), restarts any previous instance, starts Vite detached, then
# waits for it to report ready — failing loudly otherwise. Logs: /tmp/vite.log.
#
# The restart step matches the running Vite by argv (`node …/node_modules/.bin/vite`).
# `pkill -f` also matches the shell running it, so the pattern is anchored on the
# path separator (`/node_modules/[.]bin/vite`): the recipe's own command line has
# no `/node_modules/` before the `-x node_modules/.bin/vite` test, so it cannot
# self-match, while the target process still does. (The old `vite/bin/vite`
# matched neither the real process nor — worse — killed the shell itself: exit 143.)
dev-frontend: preflight
	@i=0; while [ $$i -lt 30 ]; do docker compose exec -T dev true >/dev/null 2>&1 && break; sleep 1; i=$$((i+1)); done
	@docker compose exec -T dev true >/dev/null 2>&1 || { echo "dev container is not running; run 'make dev-up' first" >&2; exit 1; }
	@docker compose exec -T dev bash -lc 'pkill -f "/node_modules/[.]bin/vite" 2>/dev/null || true; cd /workspace/frontend && { [ -x node_modules/.bin/vite ] && [ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --no-audit --no-fund; } && : > /tmp/vite.log'
	@docker compose exec -T -d dev bash -lc 'cd /workspace/frontend && exec npm run dev >/tmp/vite.log 2>&1'
	@i=0; while [ $$i -lt 30 ]; do \
	  if docker compose exec -T dev grep -q "ready in" /tmp/vite.log 2>/dev/null; then \
	    echo "frontend ready on http://localhost:$${WEB_HOST_PORT:-5173} (logs: make dev-frontend-log)"; exit 0; \
	  fi; \
	  sleep 1; i=$$((i+1)); \
	done; \
	echo "frontend did not report ready within 30s; run 'make dev-frontend-log' to see why" >&2; exit 1

dev-frontend-log:
	@docker compose exec dev tail -f /tmp/vite.log

dev-down:
	@docker compose down

dev-log:
	@docker compose logs -f dev

dev-build: preflight
	@docker compose build

reset:
	@docker compose down -v

shell: dev-shell
opencode: dev-opencode
opencode-auto: dev-opencode-auto

dev-shell: preflight
	@docker compose exec dev bash || docker compose run --rm dev bash

dev-opencode: preflight
	@if [ -z "$$(docker compose ps -q dev 2>/dev/null)" ]; then echo "[opencode] starting dev stack..."; HOST_UID=$$(id -u) HOST_GID=$$(id -g) GH_TOKEN=$$(scripts/resolve-gh-token.sh 2>/dev/null) GITHUB_TOKEN=$$(scripts/resolve-gh-token.sh 2>/dev/null) docker compose up -d dev; fi
	@if [ -t 0 ]; then docker compose exec -it dev zsh -lc "cd /workspace && opencode $(OPENCODE_ARGS)" || docker compose exec -it dev bash -lc "opencode $(OPENCODE_ARGS)"; else docker compose exec -T dev zsh -lc "cd /workspace && opencode $(OPENCODE_ARGS)" || docker compose exec -T dev bash -lc "opencode $(OPENCODE_ARGS)"; fi

# Same recipe, with --auto: auto-approve permissions that are not explicitly
# denied (every secret-file deny rule still applies).
dev-opencode-auto: OPENCODE_ARGS = --auto
dev-opencode-auto: dev-opencode
