# Copy to .env (gitignored) or export these in your shell.
# All values below are non-secret development defaults — do not put real
# credentials in this file.

# Backend (read by `cargo run` from backend/)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/realtime_leaderboard
REDIS_URL=redis://localhost:6380

# API server
PORT=8080

# Compose (host-side port overrides, so sandboxes do not collide)
HOST_PORT=8082
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Compose Postgres init (dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realtime_leaderboard

# GitHub CLI (forwarded into the sandbox at runtime; never commit a value)
# GH_TOKEN=
# GITHUB_TOKEN=
