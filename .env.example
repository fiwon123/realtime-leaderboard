# Copy to .env (gitignored) or export these in your shell.
# All values below are non-secret development defaults — do not put real
# credentials in this file.

# Backend (read by `cargo run` from backend/)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/realtime_leaderboard
REDIS_URL=redis://localhost:6380

# API server
PORT=8080

# Shared secret for the destructive admin routes (DELETE /players/{id},
# DELETE /scores). Leave unset to disable them. Put a real value only in the
# gitignored .env — never commit one.
# ADMIN_TOKEN=

# Compose (host-side port overrides, so sandboxes do not collide)
HOST_PORT=8082
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
WEB_HOST_PORT=5173

# Frontend. Vite loads env from frontend/.env (its project root); for the
# compose sandbox these are forwarded from here into the container. Empty means
# same-origin, which the dev server proxies to the API.
# VITE_API_BASE_URL=
# API_PROXY_TARGET=http://localhost:8082

# Compose Postgres init (dev only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realtime_leaderboard

# GitHub CLI (forwarded into the sandbox at runtime; never commit a value)
# GH_TOKEN=
# GITHUB_TOKEN=
