{
  "openapi": "3.1.0",
  "info": {
    "title": "realtime-leaderboard API",
    "description": "Submit score events and read live leaderboard rankings.",
    "license": {
      "name": "LicenseRef-AllRightsReserved",
      "identifier": "LicenseRef-AllRightsReserved"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "`GET /healthz` — 200 when Postgres and Redis both respond, 503 otherwise.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Postgres and Redis both responding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            }
          },
          "503": {
            "description": "At least one backing store is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBody"
                }
              }
            }
          }
        }
      }
    },
    "/leaderboard": {
      "get": {
        "tags": [
          "leaderboard"
        ],
        "summary": "`GET /leaderboard` — page through the top of the board, highest first.",
        "operationId": "get_leaderboard",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size; defaults to 10, must be 1..=100",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of entries to skip before the page; defaults to 0",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the leaderboard, highest score first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardResponse"
                }
              }
            }
          },
          "400": {
            "description": "limit outside 1..=100, or offset too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Leaderboard store failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Leaderboard store did not answer in time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/players": {
      "get": {
        "tags": [
          "leaderboard"
        ],
        "summary": "`GET /players?prefix=&limit=` — substring-search known players.",
        "operationId": "search_players",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "description": "Case-insensitive player-id substring (matched anywhere), 1..=128 bytes; exact and prefix matches rank first",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max suggestions; defaults to 5, must be 1..=25",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 25,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching player ids, closest match first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Blank/overlong prefix, or limit outside 1..=25",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/players/{player_id}": {
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "`DELETE /players/{player_id}` — remove one player from both stores.",
        "operationId": "delete_player",
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "description": "Player id to remove",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Player removed (idempotent — unknown ids still return 204)"
          },
          "400": {
            "description": "Blank or overlong player_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Delete failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "ADMIN_TOKEN is not configured; admin routes are disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/players/{player_id}/rank": {
      "get": {
        "tags": [
          "leaderboard"
        ],
        "summary": "`GET /players/{player_id}/rank` — a player's live board position.",
        "operationId": "get_rank",
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "description": "Player id, 1..=128 bytes",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The player's live standing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankResponse"
                }
              }
            }
          },
          "400": {
            "description": "Blank or overlong player_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Player has no standing yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Leaderboard store failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Leaderboard store did not answer in time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/scores": {
      "post": {
        "tags": [
          "scores"
        ],
        "summary": "`POST /scores` — 201 on a new event, 200 on an idempotent replay.",
        "operationId": "submit_score",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Duplicate event_id — already ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreEventResponse"
                }
              }
            }
          },
          "201": {
            "description": "Event stored durably; the live ranking is updated best-effort",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreEventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload, blank/overlong player_id, or score outside 0..=1_000_000_000",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Could not store the event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "`DELETE /scores` — clear every event and standing from both stores.",
        "operationId": "clear_scores",
        "responses": {
          "204": {
            "description": "All events and standings removed"
          },
          "401": {
            "description": "Missing or incorrect bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Clear failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "ADMIN_TOKEN is not configured; admin routes are disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "leaderboard"
        ],
        "summary": "`GET /stats` — board size and peak score.",
        "operationId": "get_stats",
        "responses": {
          "200": {
            "description": "Board size and peak score",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Leaderboard store failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Leaderboard store did not answer in time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "The JSON body carried by every [`ApiError`] response.\n\nPublic and [`ToSchema`]-derived so the OpenAPI document can describe error\nresponses with a real schema (and clients can generate an error type) rather\nthan a bare description.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable, client-safe error message.",
            "example": "bad request: score must be between 0 and 1000000000"
          }
        }
      },
      "HealthBody": {
        "type": "object",
        "required": [
          "status",
          "postgres",
          "redis"
        ],
        "properties": {
          "postgres": {
            "type": "boolean"
          },
          "redis": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "description": "`\"ok\"` when both stores answer, `\"degraded\"` otherwise.",
            "example": "ok"
          }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "required": [
          "rank",
          "player_id",
          "score"
        ],
        "properties": {
          "player_id": {
            "type": "string",
            "example": "alice"
          },
          "rank": {
            "type": "integer",
            "format": "int64",
            "description": "1-based position, 1 = the current leader.",
            "minimum": 0
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "description": "Best score, as the integer part of the composite."
          }
        }
      },
      "LeaderboardResponse": {
        "type": "object",
        "required": [
          "entries",
          "total"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderboardEntry"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of players with a standing on the board (independent of the\nrequested page), so a client can render paging controls.",
            "minimum": 0
          }
        }
      },
      "PlayersResponse": {
        "type": "object",
        "required": [
          "players"
        ],
        "properties": {
          "players": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Matching player ids, closest match first."
          }
        }
      },
      "RankResponse": {
        "type": "object",
        "required": [
          "player_id",
          "rank",
          "score"
        ],
        "properties": {
          "player_id": {
            "type": "string",
            "example": "alice"
          },
          "rank": {
            "type": "integer",
            "format": "int64",
            "description": "1-based position, 1 = the current leader.",
            "minimum": 0
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "description": "Best score, as the integer part of the composite."
          }
        }
      },
      "ScoreEvent": {
        "type": "object",
        "required": [
          "event_id",
          "player_id",
          "score"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "example": "10a60a3a-c86c-4427-ae39-2db5a38e0dbd"
          },
          "player_id": {
            "type": "string",
            "example": "alice",
            "maxLength": 128,
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "example": 100,
            "maximum": 1000000000,
            "minimum": 0
          }
        }
      },
      "ScoreEventResponse": {
        "type": "object",
        "required": [
          "event_id",
          "player_id",
          "score",
          "duplicate"
        ],
        "properties": {
          "duplicate": {
            "type": "boolean",
            "description": "`true` when this `event_id` had already been ingested."
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "example": "10a60a3a-c86c-4427-ae39-2db5a38e0dbd"
          },
          "player_id": {
            "type": "string",
            "example": "alice"
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "example": 100
          }
        }
      },
      "StatsResponse": {
        "type": "object",
        "required": [
          "players"
        ],
        "properties": {
          "players": {
            "type": "integer",
            "format": "int64",
            "description": "Number of players with a standing on the board.",
            "minimum": 0
          },
          "top_score": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Highest score on the board, or `null` when it is empty."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness probes"
    },
    {
      "name": "scores",
      "description": "Score event ingestion"
    },
    {
      "name": "leaderboard",
      "description": "Live ranking reads"
    },
    {
      "name": "admin",
      "description": "Token-gated destructive operations"
    }
  ]
}
